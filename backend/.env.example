# At least one key. Providers are tried in LLM_PROVIDERS order (fallback if one fails).
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDERS=groq,gemini
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
# Tokens of chat processed per extraction pass (long chats use several passes)
WINDOW_TOKENS=3000
MAX_OUTPUT_TOKENS=2048
HANDOFF_DB=data/handoff.db
